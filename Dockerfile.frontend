FROM node:22-bookworm-slim AS builder
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils ca-certificates && rm -rf /var/lib/apt/lists/*
COPY runtime-source.tar.xz /tmp/runtime-source.tar.xz
RUN mkdir -p /work/src && tar -xJf /tmp/runtime-source.tar.xz -C /work/src && rm /tmp/runtime-source.tar.xz
WORKDIR /work/src/frontend
RUN npm install
RUN npm run build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /work/src/frontend/.next/standalone ./
COPY --from=builder /work/src/frontend/.next/static ./.next/static
COPY --from=builder /work/src/frontend/public ./public
EXPOSE 3000
CMD ["sh", "-c", "HOSTNAME=0.0.0.0 PORT=${PORT:-3000} node server.js"]
