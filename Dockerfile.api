FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils libreoffice-impress libreoffice-core fonts-dejavu-core curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY runtime-source.tar.xz /tmp/runtime-source.tar.xz
RUN tar -xJf /tmp/runtime-source.tar.xz -C /app && rm /tmp/runtime-source.tar.xz
RUN pip install --upgrade pip && pip install -r requirements.txt
RUN mkdir -p storage/uploads storage/media storage/exports
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && (python -m app.scripts.worker &) && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
